# Backend (read by the API, dispatcher and seed script; all prefixed RELAY_)
RELAY_ENV=development
RELAY_DATABASE_URL=postgresql+asyncpg://relay:relay@127.0.0.1:5508/relay
RELAY_API_PORT=8108
RELAY_CORS_ORIGINS=["http://localhost:3108"]
RELAY_JWT_SECRET=change-me-to-a-long-random-string
RELAY_API_KEY_PEPPER=change-me-to-another-long-random-string
RELAY_LOG_JSON=false
RELAY_LOGIN_ATTEMPTS_PER_MINUTE=10
RELAY_LOGIN_ATTEMPTS_PER_MINUTE_PER_CLIENT=60

# Dispatcher tuning
RELAY_DISPATCHER_WORKERS=16
RELAY_DISPATCHER_LEASE_SECONDS=60
RELAY_RETRY_MAX_ATTEMPTS=8
RELAY_BREAKER_FAILURE_THRESHOLD=5
RELAY_ALLOW_PRIVATE_ENDPOINTS=true

# Mount the chaos receiver under /chaos on the API (single-port local demo)
RELAY_CHAOS_MOUNT=true
RELAY_CHAOS_VERIFY_SECRET=whsec_cmVsYXktZGVtby1zaWduaW5nLXNlY3JldC0wMQ==

# Tests: point at an existing *_test database instead of starting a testcontainer
# RELAY_TEST_DATABASE_URL=postgresql+asyncpg://relay@127.0.0.1:5508/relay_test

# Web console (server-side only; the browser talks to Next.js, never to the API directly)
RELAY_API_URL=http://127.0.0.1:8108
# Defaults to true in production builds; set false when the console is served over plain http
RELAY_SECURE_COOKIES=false
# Pre-fill the sign-in form with the seeded demo account
NEXT_PUBLIC_DEMO_MODE=true
